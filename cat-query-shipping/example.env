# ==================================
# Cat Query Shipping Server
# Environment Configuration
# ==================================

# ----- Node Environment -----
# Set to 'dev' for development, 'production' for production
NODE_ENV=dev

# ----- Server Port -----
# The port your server will run on (default: 3000)
PORT=3000

# ----- MongoDB Connection Strings -----
# MongoDB connection string for production
# Get this from MongoDB Atlas: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/cat-query-shipping

# MongoDB connection string for development (used when NODE_ENV=dev)
# You can use the same as CONNECTION_STRING or a separate dev database
CONNECTION_STRING_DEV=mongodb+srv://username:password@cluster.mongodb.net/cat-query-shipping-dev

# ----- Auth0 Configuration -----
# Get these from your Auth0 dashboard: https://manage.auth0.com

# Your Auth0 domain (e.g., dev-abc123.us.auth0.com)
AUTH_DOMAIN=your-auth0-domain.auth0.com

# Your Auth0 API audience/identifier (e.g., https://your-api-identifier)
# This is typically a URL that identifies your API in Auth0
AUTH_AUDIENCE=https://your-api-audience

# Your Auth0 application client ID (e.g., abc123xyz456...)
AUTH_CLIENT_ID=your-auth0-client-id

# ==================================
# SETUP INSTRUCTIONS
# ==================================

# 1. Copy this file to .env in the same directory
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit the .env file to version control (it's in .gitignore)

# For MongoDB:
# - Sign up at https://cloud.mongodb.com
# - Create a cluster
# - Create a database user
# - Get your connection string from "Connect" -> "Connect your application"

# For Auth0:
# - Sign up at https://auth0.com
# - Create a new application (Single Page Application)
# - Create an API in the Auth0 dashboard
# - Copy the domain, client ID, and API audience
# - Configure allowed callback/logout URLs
# - Enable RBAC in your API settings
